# .gitattributes
#
# These files are intentionally committed (see CLAUDE.md / package.json). This file
# only changes how they are *displayed* — it collapses them in GitHub diffs/PRs and
# excludes them from language statistics. It does NOT remove anything from git.

# --- Generated: committed ANTLR parser (validator needs no Java at runtime) ---
tools/sysml-validator/generated/**            linguist-generated=true

# --- Vendored: third-party SysML v2 grammar (OMG, MIT) and the npm tarball ---
docs/sysml-v2-reference/grammar/**            linguist-vendored=true
vendor/**                                     linguist-vendored=true

# --- Generated: lockfile committed for the Rust viewer binary ---
tools/decisym-viewer/Cargo.lock               linguist-generated=true

# --- Binary demo render outputs (regenerable via `pnpm render:views`) ---
examples/angars/diagrams/**                   binary linguist-generated=true
