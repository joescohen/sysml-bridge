      ],
      "verifyMethod": "Analysis"
    },
    {
      "id": "ANGARS-117",
      "name": "Refueling Queue Reprioritization",
      "statement": "The HMI shall allow operators to manually reprioritize refueling queues during emergencies.",
      "needIds": [
        "N12"
      ],
      "verifyMethod": "Demonstration"
    },
    {
      "id": "ANGARS-141",
      "name": "Fuel Schedule Optimization",
      "statement": "The system shall employ an optimized fuel transfering schedule based on receiving aircraft priority.",
      "needIds": [
        "N15"
      ],
      "verifyMethod": "Analysis"
    },
    {
      "id": "ANGARS-147",
      "name": "Low-Fuel Priority",
      "statement": "The system shall prioritize refueling for low-fuel receiving aircraft first.",
      "needIds": [
        "N15"
      ],
      "verifyMethod": "Analysis"
    },
    {
      "id": "ANGARS-149",
      "name": "Refueling Request Processing",
      "statement": "The system shall receive, authenticate, and process refueling requests from ground control via satellite within 10 seconds (T), 8 seconds (O).",
      "needIds": [
        "N16"
      ],
      "verifyMethod": "Test"
    },
    {
      "id": "ANGARS-150",
      "name": "Refueling Priority Logic",
      "statement": "The system shall prioritize refueling requests based on aircraft fuel urgency, mission criticality, and operational efficiency algorithms.",
      "needIds": [
        "N16"
      ],
      "verifyMethod": "Analysis"
    },
    {
      "id": "ANGARS-151",
      "name": "Schedule Generation Speed",
      "statement": "The system shall generate a refueling schedule and broadcast it to queued aircraft and the ground within 30 seconds (T), 20 seconds (O) of mission assignment.",
      "needIds": [
        "N16"
      ],
      "verifyMethod": "Demonstration"
    },
    {
      "id": "ANGARS-152",
      "name": "Dynamic Schedule Updates",
      "statement": "The system shall update schedules dynamically in response to new requests or mission disruptions (e.g., threats, weather).",
      "needIds": [
        "N16"
      ],
      "verifyMethod": "Test"
    },
    {
      "id": "ANGARS-153",
      "name": "Post-Mission Reporting",
      "statement": "The system shall generate and transmit post-mission reports (fuel transferred, anomalies, threats) to ground control within 5 minutes (T), 3 minutes (O) of mission completion.",
      "needIds": [
        "N16"
      ],
      "verifyMethod": "Demonstration"
    },
    {
      "id": "ANGARS-154",
      "name": "Mission Status Updates",
      "statement": "The system shall transmit mission status updates to ground control every 30 seconds.",
      "needIds": [
        "N16"
      ],
      "verifyMethod": "Demonstration"
    }
