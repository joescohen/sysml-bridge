node_modules/
dist/
*.tsbuildinfo
.env
.env.local
.DS_Store
coverage/

# Runtime data
topology.json
examples/**/.mbse-session.json

# Synthetic stress-test output (generated by scripts/synthetic-stress.ts) and
# scratch repros from the adversarial bug-hunt — both regenerated on demand.
.synthetic-stress/
.bughunt/

# ANGARS corpus — proprietary academic capstone + 3rd-party docs; NEVER publish.
# Raw input corpus and the human-built reference model stay local-only.
examples/angars/corpus/
examples/angars/reference-model/
# ANGARS extracted model artifacts + audit reports — generated, corpus-derived; local-only.
examples/angars/model/
examples/angars/audits/

# Internal planning/research artifacts (not for public repo)
.planning/

# Internal dev artifacts
docs/superpowers/
docs/REVIEW.md

# Editor/tool-specific local config
.claude/
.codex/

# Python virtualenvs (local-only; recreate via tools/sysml-validator/requirements.txt)
.venv/
.venv-syside/

# Stray tsc outputs under scripts/ (the .ts sources are tracked; their JS/d.ts are not)
scripts/*.js
scripts/*.d.ts
scripts/*.d.ts.map
scripts/*.js.map

# Python bytecode caches (regenerated on every run)
__pycache__/
*.pyc

# The committed SysML validator parser MUST be tracked (negate any broad ignore above).
!tools/sysml-validator/generated/
!tools/sysml-validator/generated/**
# ...but never commit the bytecode cache that running it produces.
tools/sysml-validator/generated/__pycache__/

# MCP file-store runtime data (per-project; not source)
.sysml-bridge/

# inference/prose decision + candidate files (corpus-derived; rationale is audit-only)
examples/angars/model/inferred-*.json
examples/angars/model/prose-*.json
examples/angars/model/inference-candidates.json
