# Copy this file to .env and fill in your values

# SysON endpoint (web-based SysML v2 modeling tool)
SYSON_ENDPOINT=http://localhost:8080

# SysON URL for the dashboard frontend (Vite injects this)
VITE_SYSON_URL=http://localhost:8080

# Anthropic API key (required for the chat feature in the dashboard)
ANTHROPIC_API_KEY=sk-ant-...
