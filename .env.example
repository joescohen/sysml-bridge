# Copy to `.env` (gitignored) and fill in. `pnpm weave` and `pnpm weave:eval`
# auto-load `.env` via node's --env-file-if-exists (no effect if `.env` is absent).
# NOTE: node's --env-file does NOT override variables already set in your shell —
# if you also exported one of these (e.g. in ~/.zshenv), unset it so `.env` wins.

# OpenRouter (preferred) — GLM via OpenRouter's OpenAI-compatible API.
OPENROUTER_API_KEY=

# Model slug for OpenRouter; defaults to z-ai/glm-5.2 when unset.
OPENROUTER_MODEL=z-ai/glm-5.2

# Anthropic (alternative). OpenRouter takes precedence when both keys are set.
ANTHROPIC_API_KEY=
